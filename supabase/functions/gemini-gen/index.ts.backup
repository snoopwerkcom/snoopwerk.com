import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"

// ✅ RATE LIMITING
const rateLimitMap = new Map<string, { count: number; resetTime: number }>();

function checkRateLimit(customerId: string | null): boolean {
  const key = customerId || 'anonymous';
  const now = Date.now();
  const limit = customerId ? 100 : 20;
  const windowMs = 60 * 60 * 1000;

  const userData = rateLimitMap.get(key);

  if (!userData || now > userData.resetTime) {
    rateLimitMap.set(key, { count: 1, resetTime: now + windowMs });
    return true;
  }

  if (userData.count >= limit) return false;

  userData.count++;
  return true;
}

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
  'Access-Control-Allow-Methods': 'POST, OPTIONS',
}

const CREDIT_COSTS: Record<string, number> = {
  'generate': 20,
  'edit': 20,
  'remove-bg': 10,
  'upscale': 10,
  'text': 0,
  'analyze': 0,
}

// ─────────────────────────────────────────────
// IMAGE GENERATION HELPERS
// ─────────────────────────────────────────────

/** Gemini 2.0 Flash image generation (PRIMARY). Returns a full data-URI. */
async function geminiGenerateImage(prompt: string, aspectRatio: string, geminiKey: string): Promise<string> {
  console.log('🎨 Generating image with Gemini 2.0 Flash');
  
  const fullPrompt = aspectRatio !== '1:1' 
    ? `${prompt}. Create this image in ${aspectRatio} aspect ratio.`
    : prompt;

  const response = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent?key=${geminiKey}`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{
          parts: [{ text: fullPrompt }]
        }],
        generationConfig: {
          responseModalities: ["TEXT", "IMAGE"],
          temperature: 1.0,
          topP: 0.95,
          maxOutputTokens: 8192,
        }
      }),
    }
  );

  if (!response.ok) {
    const errorText = await response.text();
    console.error('❌ Gemini image gen error:', errorText.substring(0, 500));
    throw new Error(`Gemini image gen failed (${response.status}): ${errorText.substring(0, 200)}`);
  }

  const result = await response.json();
  const parts = result.candidates?.[0]?.content?.parts || [];
  const imagePart = parts.find((p: any) => p.inlineData?.mimeType?.startsWith('image/'));

  if (!imagePart?.inlineData?.data) {
    console.error('❌ No image in Gemini response:', JSON.stringify(result).substring(0, 500));
    throw new Error('Gemini did not return an image');
  }

  const mimeType = imagePart.inlineData.mimeType || 'image/png';
  const base64Data = imagePart.inlineData.data;

  console.log('✅ Image generated successfully via Gemini');
  return `data:${mimeType};base64,${base64Data}`;
}

/** Replicate API image generation (FALLBACK). Returns a full data-URI. */
async function replicateGenerateImage(prompt: string, aspectRatio: string, replicateKey: string): Promise<string> {
  console.log('🎨 Using Replicate as fallback');
  
  // Map aspect ratios to Replicate format
  const aspectRatioMap: Record<string, string> = {
    '1:1': '1:1',
    '16:9': '16:9',
    '9:16': '9:16',
    '4:3': '4:3',
    '3:4': '3:4',
  };

  // Create prediction
  const createResponse = await fetch('https://api.replicate.com/v1/predictions', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${replicateKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      version: 'black-forest-labs/flux-schnell',  // Fast, free model
      input: {
        prompt: prompt || 'a beautiful image',
        aspect_ratio: aspectRatioMap[aspectRatio] || '1:1',
        output_format: 'png',
      }
    }),
  });

  if (!createResponse.ok) {
    const error = await createResponse.text();
    console.error('❌ Replicate create error:', error.substring(0, 300));
    throw new Error(`Replicate create failed: ${createResponse.status}`);
  }

  const prediction = await createResponse.json();
  const predictionId = prediction.id;

  console.log(`⏳ Replicate prediction created: ${predictionId}`);

  // Poll for completion (max 30 seconds)
  let attempts = 0;
  const maxAttempts = 30;
  
  while (attempts < maxAttempts) {
    await new Promise(resolve => setTimeout(resolve, 1000)); // Wait 1 second
    
    const statusResponse = await fetch(
      `https://api.replicate.com/v1/predictions/${predictionId}`,
      {
        headers: {
          'Authorization': `Bearer ${replicateKey}`,
        },
      }
    );

    if (!statusResponse.ok) {
      throw new Error(`Replicate status check failed: ${statusResponse.status}`);
    }

    const status = await statusResponse.json();
    
    if (status.status === 'succeeded') {
      const imageUrl = status.output?.[0];
      if (!imageUrl) {
        throw new Error('Replicate succeeded but returned no image URL');
      }

      console.log('✅ Replicate generation complete, fetching image...');

      // Fetch the image and convert to base64
      const imageResponse = await fetch(imageUrl);
      const imageBuffer = await imageResponse.arrayBuffer();
      const bytes = new Uint8Array(imageBuffer);
      
      let binary = '';
      const chunkSize = 8192;
      for (let i = 0; i < bytes.length; i += chunkSize) {
        const chunk = bytes.subarray(i, Math.min(i + chunkSize, bytes.length));
        binary += String.fromCharCode.apply(null, Array.from(chunk));
      }

      console.log('✅ Image generated via Replicate');
      return `data:image/png;base64,${btoa(binary)}`;
    }
    
    if (status.status === 'failed') {
      throw new Error(`Replicate generation failed: ${status.error || 'Unknown error'}`);
    }
    
    attempts++;
  }

  throw new Error('Replicate generation timed out after 30 seconds');
}

/**
 * Try Gemini FIRST → fall back to Replicate on failure
 */
async function generateImageWithFallback(
  prompt: string,
  aspectRatio: string,
  geminiKey: string | null,
  replicateKey: string | null
): Promise<{ imageUrl: string; provider: string }> {
  
  // ── attempt 1: Gemini (PRIMARY) ──
  if (geminiKey) {
    try {
      const imageUrl = await geminiGenerateImage(prompt, aspectRatio, geminiKey);
      return { imageUrl, provider: 'gemini' };
    } catch (e: any) {
      console.warn('⚠️ Gemini failed, trying Replicate fallback:', e.message);
      // fall through to Replicate
    }
  }

  // ── attempt 2: Replicate (FALLBACK) ──
  if (replicateKey) {
    try {
      const imageUrl = await replicateGenerateImage(prompt, aspectRatio, replicateKey);
      return { imageUrl, provider: 'replicate' };
    } catch (e: any) {
      console.error('❌ Both Gemini and Replicate failed:', e.message);
      throw new Error(`Image generation failed. Gemini: ${geminiKey ? 'tried and failed' : 'no key'}. Replicate: ${e.message}`);
    }
  }

  throw new Error('No image generation API configured. Need GEMINI_API_KEY (primary) or REPLICATE_API_TOKEN (fallback)');
}

// ─────────────────────────────────────────────
// MAIN EDGE FUNCTION
// ─────────────────────────────────────────────

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders });
  }

  try {
    const body = await req.json();
    const { prompt, imageBase64, style, action, context, customerId } = body;

    console.log(`📝 Action: ${action}, Customer: ${customerId || 'free'}`);
    console.log(`📝 Prompt: ${prompt?.substring(0, 100) || 'N/A'}`);

    // ── rate limit ──
    if (!checkRateLimit(customerId)) {
      console.log(`⚠️ Rate limit exceeded for ${customerId || 'anonymous'}`);
      return new Response(
        JSON.stringify({ error: 'Rate limit exceeded. Please try again in an hour.' }),
        { status: 429, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      );
    }

    const geminiKey = Deno.env.get('GEMINI_API_KEY');
    const replicateKey = Deno.env.get('REPLICATE_API_TOKEN');

    console.log(`🔑 Keys available: Gemini=${!!geminiKey}, Replicate=${!!replicateKey}`);

    let creditsRemaining: number | undefined;

    // ── credit deduction for PAID users ──
    if (customerId) {
      const creditsNeeded = CREDIT_COSTS[action] || 0;

      if (creditsNeeded > 0) {
        const supabaseClient = createClient(
          Deno.env.get('SUPABASE_URL') ?? '',
          Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
        );

        console.log(`💰 Checking credits for customer ${customerId}`);

        const { data: customer, error: fetchError } = await supabaseClient
          .from('customers')
          .select('credits_remaining')
          .eq('stripe_customer_id', customerId)
          .maybeSingle();

        if (fetchError) {
          console.error('❌ Error fetching customer:', fetchError);
          throw new Error('Failed to fetch customer credits');
        }
        if (!customer) {
          console.error('❌ Customer not found:', customerId);
          throw new Error('Customer not found');
        }

        console.log(`Current credits: ${customer.credits_remaining}, needed: ${creditsNeeded}`);

        if (customer.credits_remaining < creditsNeeded) {
          return new Response(
            JSON.stringify({
              error: 'insufficient_credits',
              credits_needed: creditsNeeded,
              credits_available: customer.credits_remaining,
            }),
            { status: 402, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
          );
        }

        const newCredits = customer.credits_remaining - creditsNeeded;
        const { data: updatedCustomer, error: updateError } = await supabaseClient
          .from('customers')
          .update({ credits_remaining: newCredits })
          .eq('stripe_customer_id', customerId)
          .select('credits_remaining')
          .single();

        if (updateError) {
          console.error('❌ Error updating credits:', updateError);
          throw new Error('Failed to update credits');
        }

        creditsRemaining = updatedCustomer.credits_remaining;
        console.log(`✅ Credits deducted: ${customer.credits_remaining} → ${creditsRemaining}`);
      } else {
        // 0-cost action — just fetch current balance
        const supabaseClient = createClient(
          Deno.env.get('SUPABASE_URL') ?? '',
          Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
        );
        const { data: customer } = await supabaseClient
          .from('customers')
          .select('credits_remaining')
          .eq('stripe_customer_id', customerId)
          .maybeSingle();
        creditsRemaining = customer?.credits_remaining;
      }
    }

    // ─────────────────────────────────────────
    // TEXT / ANALYZE  (Gemini)
    // ─────────────────────────────────────────
    if (action === 'text' || action === 'analyze') {
      if (!geminiKey) throw new Error('GEMINI_API_KEY not set');

      console.log('🧠 Processing text/analysis with Gemini');

      const textPrompt = prompt || context || 'Analyze this content.';
      const parts: any[] = [{ text: textPrompt }];

      if (imageBase64) {
        const cleanBase64 = imageBase64.includes(',') ? imageBase64.split(',')[1] : imageBase64;
        parts.push({ inline_data: { mime_type: 'image/png', data: cleanBase64 } });
      }

      const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent?key=${geminiKey}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts }],
            generationConfig: { 
              temperature: 0.7, 
              maxOutputTokens: 2048,
            },
          }),
        }
      );

      if (!response.ok) {
        const errorText = await response.text();
        console.error('❌ Gemini text error:', errorText.substring(0, 500));
        throw new Error(`Gemini text generation failed: ${response.status}`);
      }

      const result = await response.json();
      const text = result.candidates?.[0]?.content?.parts?.[0]?.text || 'No response';

      console.log('✅ Text/analysis generated');

      return new Response(
        JSON.stringify({ text, summary: text, credits: creditsRemaining }),
        { headers: { ...corsHeaders, 'Content-Type': 'application/json' }, status: 200 }
      );
    }

    // ─────────────────────────────────────────
    // GENERATE IMAGE  — Gemini primary → Replicate fallback
    // ─────────────────────────────────────────
    if (action === 'generate') {
      console.log('🎨 Generating image');

      const aspectRatio = style === '16:9' ? '16:9'
        : style === '9:16'  ? '9:16'
        : style === '4:3'   ? '4:3'
        : style === '3:4'   ? '3:4'
        : '1:1';

      const { imageUrl, provider } = await generateImageWithFallback(
        prompt || 'a beautiful image',
        aspectRatio,
        geminiKey,
        replicateKey
      );

      return new Response(
        JSON.stringify({ imageUrl, credits: creditsRemaining, provider }),
        { headers: { ...corsHeaders, 'Content-Type': 'application/json' }, status: 200 }
      );
    }

    // ─────────────────────────────────────────
    // EDIT IMAGE  — Gemini analysis → Gemini/Replicate generation
    // ─────────────────────────────────────────
    if (action === 'edit') {
      if (!imageBase64) throw new Error('No image provided');
      if (!geminiKey)   throw new Error('GEMINI_API_KEY not set');

      console.log('✏️ Magic Edit — Gemini analysis + generation');

      const cleanBase64 = imageBase64.includes(',') ? imageBase64.split(',')[1] : imageBase64;

      // Step 1: Gemini analyzes the source image
      const analysisPrompt = `You are an expert image editor and prompt engineer.

Current image: (attached)
User's edit request: "${prompt || 'enhance and improve this image'}"

Create a detailed, specific prompt for an AI image generator that will produce an edited version of this image.
The prompt should:
1. Describe the main subject and composition
2. Apply the user's requested edits
3. Specify style, lighting, colors, and mood
4. Be under 200 words

Output ONLY the image generation prompt, nothing else. No explanations, no markdown, just the prompt.`;

      const analysisResponse = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent?key=${geminiKey}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{
              parts: [
                { text: analysisPrompt },
                { inline_data: { mime_type: 'image/png', data: cleanBase64 } },
              ],
            }],
            generationConfig: { temperature: 0.7, maxOutputTokens: 500 },
          }),
        }
      );

      if (!analysisResponse.ok) {
        const errorText = await analysisResponse.text();
        console.error('❌ Gemini analysis error:', errorText.substring(0, 500));
        throw new Error(`Gemini analysis failed: ${analysisResponse.status}`);
      }

      const analysisResult = await analysisResponse.json();
      const enhancedPrompt = analysisResult.candidates?.[0]?.content?.parts?.[0]?.text || prompt;

      console.log('✅ Analysis complete');
      console.log('📝 Enhanced prompt:', enhancedPrompt.substring(0, 100) + '...');

      // Step 2: Generate the edited image
      const { imageUrl, provider } = await generateImageWithFallback(
        enhancedPrompt.trim(),
        '1:1',
        geminiKey,
        replicateKey
      );

      console.log(`✅ Magic edit complete (provider: ${provider})`);

      return new Response(
        JSON.stringify({ 
          imageUrl, 
          credits: creditsRemaining, 
          provider, 
          method: `gemini_analysis_${provider}_generation` 
        }),
        { headers: { ...corsHeaders, 'Content-Type': 'application/json' }, status: 200 }
      );
    }

    // ─────────────────────────────────────────
    // REMOVE BACKGROUND  (remove.bg)
    // ─────────────────────────────────────────
    if (action === 'remove-bg') {
      const removeBgKey = Deno.env.get('REMOVEBG_API_KEY');
      if (!removeBgKey || !imageBase64) {
        throw new Error('Missing requirements for background removal');
      }

      console.log('✂️ Removing background');

      const cleanBase64 = imageBase64.includes(',') ? imageBase64.split(',')[1] : imageBase64;
      const binaryString = atob(cleanBase64);
      const bgInputBytes = new Uint8Array(binaryString.length);
      for (let i = 0; i < binaryString.length; i++) {
        bgInputBytes[i] = binaryString.charCodeAt(i);
      }
      const blob = new Blob([bgInputBytes], { type: 'image/png' });

      const form = new FormData();
      form.append('image_file', blob, 'image.png');
      form.append('size', 'auto');

      const res = await fetch('https://api.remove.bg/v1.0/removebg', {
        method: 'POST',
        headers: { 'X-Api-Key': removeBgKey },
        body: form,
      });

      if (!res.ok) {
        const errorText = await res.text();
        console.error('❌ remove.bg error:', errorText.substring(0, 300));
        throw new Error(`remove.bg failed: ${res.status}`);
      }

      const bgBuffer = await res.arrayBuffer();
      const bgBytes  = new Uint8Array(bgBuffer);
      let bgBinary   = '';
      const bgChunkSize = 8192;
      for (let i = 0; i < bgBytes.length; i += bgChunkSize) {
        const chunk = bgBytes.subarray(i, Math.min(i + bgChunkSize, bgBytes.length));
        bgBinary += String.fromCharCode.apply(null, Array.from(chunk));
      }

      console.log('✅ Background removed');

      return new Response(
        JSON.stringify({ imageUrl: `data:image/png;base64,${btoa(bgBinary)}`, credits: creditsRemaining }),
        { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      );
    }

    // ─────────────────────────────────────────
    // UPSCALE  (Replicate - using Real-ESRGAN)
    // ─────────────────────────────────────────
    if (action === 'upscale') {
      if (!replicateKey || !imageBase64) {
        throw new Error('REPLICATE_API_TOKEN required for upscaling');
      }

      console.log('💎 Upscaling image with Replicate');

      // Create prediction for upscaling
      const createResponse = await fetch('https://api.replicate.com/v1/predictions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${replicateKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          version: 'nightmareai/real-esrgan',  // Image upscaling model
          input: {
            image: imageBase64,  // Can accept data URI
            scale: 4,
          }
        }),
      });

      if (!createResponse.ok) {
        const error = await createResponse.text();
        throw new Error(`Replicate upscale create failed: ${createResponse.status}`);
      }

      const prediction = await createResponse.json();
      const predictionId = prediction.id;

      // Poll for completion
      let attempts = 0;
      const maxAttempts = 60; // 60 seconds for upscaling
      
      while (attempts < maxAttempts) {
        await new Promise(resolve => setTimeout(resolve, 1000));
        
        const statusResponse = await fetch(
          `https://api.replicate.com/v1/predictions/${predictionId}`,
          { headers: { 'Authorization': `Bearer ${replicateKey}` } }
        );

        const status = await statusResponse.json();
        
        if (status.status === 'succeeded') {
          const upscaledUrl = status.output;
          
          // Fetch and convert to base64
          const imageResponse = await fetch(upscaledUrl);
          const imageBuffer = await imageResponse.arrayBuffer();
          const bytes = new Uint8Array(imageBuffer);
          
          let binary = '';
          const chunkSize = 8192;
          for (let i = 0; i < bytes.length; i += chunkSize) {
            const chunk = bytes.subarray(i, Math.min(i + chunkSize, bytes.length));
            binary += String.fromCharCode.apply(null, Array.from(chunk));
          }

          console.log('✅ Image upscaled via Replicate');
          return new Response(
            JSON.stringify({ imageUrl: `data:image/png;base64,${btoa(binary)}`, credits: creditsRemaining }),
            { headers: { ...corsHeaders, 'Content-Type': 'application/json' }, status: 200 }
          );
        }
        
        if (status.status === 'failed') {
          throw new Error(`Replicate upscale failed: ${status.error}`);
        }
        
        attempts++;
      }

      throw new Error('Replicate upscale timed out');
    }

    throw new Error(`Unsupported action: ${action}`);

  } catch (error: any) {
    console.error('💥 Error:', {
      message: error.message,
      timestamp: new Date().toISOString(),
      stack: error.stack?.substring(0, 500),
    });

    return new Response(
      JSON.stringify({ 
        error: error.message,
        timestamp: new Date().toISOString()
      }),
      { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    );
  }
})